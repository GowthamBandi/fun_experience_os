{
  "name": "experience-os-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth --project demo-experience-os",
    "test": "jest",
    "test:tune": "jest --testPathIgnorePatterns=/node_modules/ -- test/tune-retry.test.ts",
    "test:emulator": "npm run build && firebase emulators:exec --project demo-experience-os --only firestore,functions,auth \"npm test\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "seed:emulator": "node --no-warnings scripts/seed-governance-emulator.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "maxWorkers": 1,
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 120000,
    "transform": {
      "^.+[.]tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/tune-retry\\.test\\.ts$"
    ]
  },
  "engines": {
    "node": "22"
  }
}
