{
  "name": "operations-web",
  "version": "0.1.0",
  "private": true,
  "description": "Experience OS \u2014 Operations Console (Super Admin governance, Firebase-backed)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "node scripts/verify-production-env.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "smoke": "node tests/smoke/login-config.smoke.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "playwright": "^1.62.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
