# Operations Console — production build environment (TEMPLATE: no real values).
# Set these in the hosting/CI environment for the production backend (App Hosting:
# apphosting.production.yaml; see DEPLOYMENT.md). Every NEXT_PUBLIC_* value is inlined into the
# browser bundle at BUILD time and is public (Firebase web config is not a secret);
# never put server secrets in NEXT_PUBLIC_* variables.
#
# Build with:  npm run build:production
# scripts/verify-production-env.mjs refuses the build if anything below is missing,
# still a placeholder, or inconsistent (e.g. a staging project id with APP_ENV=production).

# Data source. Must be firebase-live for any deployed build.
NEXT_PUBLIC_DATA_MODE=firebase-live

# Which environment this build is. Drives the header badge and the project-id cross-check.
#   production → project id must not contain staging/stage/stg/dev/test/qa/demo
#   staging    → project id must contain staging/stage/stg
NEXT_PUBLIC_APP_ENV=production

# Firebase web app config: Firebase Console → Project settings → Your apps → Web app (production project).
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-org-experience-os-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-org-experience-os-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-org-experience-os-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_WEB_APP_ID

# App Check: reCAPTCHA Enterprise site key (Google Cloud → Security → reCAPTCHA, type "Website",
# domains = the production console domain). Register it for the web app in Firebase → App Check.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=REPLACE_WITH_RECAPTCHA_ENTERPRISE_SITE_KEY

# Archived company-operated prototype (ADR-0006). Must stay false/unset; the build refuses "true".
NEXT_PUBLIC_SHOW_ARCHIVED_PROTOTYPE=false

# Build-time only (not NEXT_PUBLIC, never shipped to the browser): exact project id this
# environment must build against. Set it in CI/hosting so a copy-paste of the other
# environment's values fails the build.
EXPECTED_FIREBASE_PROJECT_ID=your-org-experience-os-prod
