# Experience OS — Super Admin console configuration
#
# NEXT_PUBLIC_DATA_MODE selects where the console keeps its data:
#   prototype          Local workspace (default). No backend required. Data is stored in this
#                      browser's IndexedDB, survives reloads, and can be exported/restored from
#                      Workspace settings. Operators sign in by choosing their profile.
#   firebase-emulator  Firebase Emulator Suite (project demo-experience-os). Marketplace governance
#                      reads Firestore and writes through Cloud Functions. Run from the repo root:
#                        npm run firebase:emulators   and   npm --prefix firebase/functions run seed:emulator
#                      then sign in as admin@experience.local / Local-Admin-Only-2026!
#   firebase-live      A real Firebase project (requires every value below and a reCAPTCHA
#                      Enterprise site key for App Check). `npm run build:production` verifies this.
NEXT_PUBLIC_DATA_MODE=prototype

# Firebase web app configuration (required for firebase-emulator and firebase-live)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-experience-os.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-experience-os
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-experience-os.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Required only for firebase-live
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
