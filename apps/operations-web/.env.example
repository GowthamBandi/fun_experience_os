# ──────────────────────────────────────────────────────────────────────────────
# Experience OS — Environment Variables
#
# Copy this file to .env.local and fill in values for your mode.
# .env.local is git-ignored and must never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# DATA MODE
# Allowed values: prototype | firebase-emulator | firebase-live
# Default (and safe fallback): prototype
# Unknown or missing values ALWAYS resolve to prototype, never to firebase-live.
NEXT_PUBLIC_DATA_MODE=prototype

# ── FIREBASE CLIENT SDK ────────────────────────────────────────────────────────
# Required only when NEXT_PUBLIC_DATA_MODE=firebase-emulator.
# For emulator mode, use the demo project ID and any placeholder values.
# Do NOT commit real API keys.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
