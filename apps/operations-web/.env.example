# Local development against the Firebase emulators (copy to .env.local).
# These are the emulator's fake demo values, not secrets.
NEXT_PUBLIC_DATA_MODE=firebase-emulator
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-experience-os.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-experience-os
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-experience-os.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
# Required only when NEXT_PUBLIC_DATA_MODE=firebase-live (see .env.staging.example / .env.production.example)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Ignored in emulator mode (the badge shows "Local emulator"); required for firebase-live.
NEXT_PUBLIC_APP_ENV=
# Archived company-operated prototype (ADR-0006). Local reference only; ignored in firebase-live.
NEXT_PUBLIC_SHOW_ARCHIVED_PROTOTYPE=false
